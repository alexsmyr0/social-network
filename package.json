{
	"name": "social-network",
	"version": "1.0.0",
	"description": "Commonplace social network frontend",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"serve": "bun run build && go run ./cmd/frontend",
		"preview": "vite preview",
		"test": "vitest run --coverage",
		"test:a03": "vitest run SPA/tests/unit/src",
		"test:a04": "vitest run SPA/tests/unit/src/api/registration.test.js SPA/tests/unit/src/api/session.test.js SPA/tests/unit/src/features/auth/register-page.test.js",
		"test:a05": "vitest run SPA/tests/unit/src/api/session.test.js SPA/tests/unit/src/app/router.test.js SPA/tests/unit/src/app/app-shell.test.js SPA/tests/unit/src/features/auth/session-state.test.js SPA/tests/unit/src/features/auth/login-page.test.js",
		"test:a09": "vitest run SPA/tests/unit/src/api/social.test.js SPA/tests/unit/src/features/social SPA/tests/unit/policy/no-fixtures-in-production.test.js",
		"test:e2e": "make test-e2e",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write --unsafe .",
		"format": "biome format --write .",
		"policy": "bun run build && bun run lint && bun run test",
		"test:a10": "vitest run SPA/tests/unit/src/api/notifications.test.js SPA/tests/unit/src/features/notifications SPA/tests/unit/src/features/social SPA/tests/unit/policy/no-fixtures-in-production.test.js",
		"test:a12": "vitest run SPA/tests/unit/src/api/content.test.js SPA/tests/unit/src/features/content SPA/tests/unit/src/features/social SPA/tests/unit/src/app SPA/tests/unit/policy/no-fixtures-in-production.test.js"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.12",
		"@playwright/test": "^1.59.1",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vitest/coverage-v8": "3.2.4",
		"@vue/test-utils": "^2.5.1",
		"bun": "^1.3.12",
		"jsdom": "^30.1.1",
		"vite": "^8.3.1",
		"vitest": "^3.0.7"
	},
	"dependencies": {
		"vue": "^3.5.43",
		"vue-router": "^5.3.1"
	}
}
