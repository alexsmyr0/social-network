{
	"name": "real-time-forum",
	"version": "1.0.0",
	"description": "Real-Time Forum - A Go-based SPA with WebSockets",
	"type": "module",
	"scripts": {
		"dev": "make run",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write --unsafe .",
		"format": "biome format --write .",
		"policy": "bun run lint && bun run test"
	},
	"devDependencies": {
		"bun": "^1.3.12",
		"@biomejs/biome": "^2.4.12",
		"@playwright/test": "^1.59.1",
		"@vitest/coverage-v8": "3.2.4",
		"vitest": "^3.0.7"
	}
}
